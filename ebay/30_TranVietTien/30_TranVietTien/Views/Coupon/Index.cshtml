@model IEnumerable<_30_TranVietTien.Models.Coupon>
@{
    ViewData["Title"] = "Quản lý mã giảm giá";
}

<div class="container mt-4">
    <h2 class="mb-3">🎟️ Quản lý mã giảm giá</h2>
    <button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#couponModal">+ Thêm mã</button>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Giảm (%)</th>
                <th>Hiệu lực</th>
                <th>Sản phẩm</th>
                <th>Lượt dùng</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Code</td>
                    <td>@c.DiscountPercent%</td>
                    <td>@c.StartDate?.ToShortDateString() - @c.EndDate?.ToShortDateString()</td>
                    <td>@c.Product?.Title</td>
                    <td>@c.MaxUsage</td>
                    <td>
                        <button class="btn btn-danger btn-sm" onclick="deleteCoupon(@c.Id)">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="couponModal" tabindex="-1" aria-labelledby="couponModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="couponForm">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="couponModalLabel">Thêm mã giảm giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Mã</label>
                        <input name="Code" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Giảm (%)</label>
                        <input name="DiscountPercent" type="number" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Bắt đầu</label>
                        <input name="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Kết thúc</label>
                        <input name="EndDate" type="date" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Số lượt sử dụng</label>
                        <input name="MaxUsage" type="number" class="form-control" value="10" />
                    </div>
                    <div class="mb-3">
                        <label>ID sản phẩm</label>
                        <input name="ProductId" type="number" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Lưu</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    $("#couponForm").on("submit", function (e) {
        e.preventDefault();
        $.ajax({
            url: '/Coupon/Create',
            method: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                if (res.success) {
                    alert("Tạo mã thành công!");
                    location.reload();
                }
            }
        });
    });

    function deleteCoupon(id) {
        if (!confirm("Xóa mã này?")) return;
        $.post('/Coupon/Delete', { id: id }, function (res) {
            if (res.success) {
                alert("Đã xóa!");
                location.reload();
            }
        });
    }
</script>
