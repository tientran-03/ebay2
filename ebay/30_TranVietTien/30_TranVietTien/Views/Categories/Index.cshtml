@model IEnumerable<_30_TranVietTien.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between mb-3">
    <h3 class="fw-bold">Category Management</h3>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        + Add Category
    </button>
</div>

<table class="table table-bordered table-hover" id="categoryTable">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th style="width:160px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr data-id="@c.Id">
                <td>@c.Id</td>
                <td class="catName">@c.Name</td>
                <td>
                    <button class="btn btn-sm btn-outline-dark editBtn"
                            data-id="@c.Id" data-name="@c.Name">
                        Edit
                    </button>
                    <button class="btn btn-sm btn-outline-dark deleteBtn" data-id="@c.Id">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="modal fade" id="addModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Add Category</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Name</label>
                <input id="newCategoryName" class="form-control" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="saveNewCategory">Save</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="editModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Edit Category</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editCategoryId" />
                <label class="form-label">Name</label>
                <input id="editCategoryName" class="form-control" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning" id="saveEditCategory">Update</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Delete Category</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this category?
                <input type="hidden" id="deleteCategoryId" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="toast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">Done</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        $(document).ready(function () {

            function showToast(msg, success = true) {
                $("#toastMessage").text(msg);
                $("#toast")
                    .removeClass("bg-success bg-danger")
                    .addClass(success ? "bg-success" : "bg-danger");

                const toast = new bootstrap.Toast(document.getElementById("toast"));
                toast.show();
            }
            $("#saveNewCategory").click(function () {
                $.post("/Categories/Create",
                    { name: $("#newCategoryName").val() },
                    function (res) {
                        if (res.success) {
                            showToast("Category added successfully!");
                            setTimeout(() => location.reload(), 900);
                        } else {
                            showToast("Failed to add!", false);
                        }
                    });
            });
            $(".editBtn").click(function () {
                $("#editCategoryId").val($(this).data("id"));
                $("#editCategoryName").val($(this).data("name"));
                let modal = new bootstrap.Modal(document.getElementById("editModal"));
                modal.show();
            });

            $("#saveEditCategory").click(function () {
                $.post("/Categories/Edit",
                    {
                        id: $("#editCategoryId").val(),
                        name: $("#editCategoryName").val()
                    },
                    function (res) {
                        if (res.success) {
                            showToast("Updated successfully!");
                            setTimeout(() => location.reload(), 900);
                        } else {
                            showToast("Update failed!", false);
                        }
                    });
            });
            $(".deleteBtn").click(function () {
                $("#deleteCategoryId").val($(this).data("id"));
                let modal = new bootstrap.Modal(document.getElementById("deleteModal"));
                modal.show();
            });
            $("#confirmDelete").click(function () {
                $.post("/Categories/Delete",
                    { id: $("#deleteCategoryId").val() },
                    function (res) {
                        if (res.success) {
                            showToast("Deleted successfully!");
                            setTimeout(() => location.reload(), 900);
                        } else {
                            showToast("Delete failed!", false);
                        }
                    });
            });

        });
    </script>

}
