@model List<_30_TranVietTien.Models.Message>

@{
    ViewData["Title"] = "Chat";
    var sender = ViewBag.SenderId;
    var receiver = ViewBag.ReceiverId;
    var room = ViewBag.Room;
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: #fff6fb;
    }

    .chat-header {
        background: #ff4f9a;
        color: white;
        padding: 15px 20px;
        border-bottom: 1px solid #ffc2dd;
        font-size: 1.1rem;
        font-weight: 600;
    }

        .chat-header .btn {
            background: white !important;
            color: #ff4f9a !important;
            border: none;
            font-weight: 600;
        }

    .system-product-box {
        padding: 15px;
        border-bottom: 1px solid #ffe1ed;
        display: flex;
        align-items: center;
        gap: 15px;
        background: #ffe6f1;
    }

    #chatBox {
        height: 420px;
        overflow-y: auto;
        background: #fff2f8;
        border-radius: 12px;
        padding: 15px;
        border: 1px solid #ffd6e7;
    }

    .bubble-me {
        background: #ff4f9a;
        color: white;
        padding: 10px 14px;
        border-radius: 16px;
        display: inline-block;
        max-width: 75%;
        box-shadow: 0 2px 6px rgba(255, 79, 154, 0.25);
    }
    .bubble-other {
        background: white;
        padding: 10px 14px;
        border-radius: 16px;
        display: inline-block;
        max-width: 75%;
        border: 1px solid #ffd1e4;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .timestamp {
        font-size: 0.75rem;
        color: #cc7ea4;
        margin-top: 5px;
    }

    .send-box input {
        height: 48px;
        border-radius: 10px;
        border: 1px solid #ffb6d6;
        padding-left: 14px;
        background: #fff2f8;
    }

        .send-box input:focus {
            border-color: #ff4f9a;
            box-shadow: 0 0 0 0.15rem rgba(255, 79, 154, 0.25);
        }

    .send-box button {
        border-radius: 10px;
        background: #ff4f9a;
        border-color: #ff4f9a;
        padding: 0 25px;
    }

        .send-box button:hover {
            background: #ff327d;
            border-color: #ff327d;
        }

    .card {
        border-radius: 12px;
        border: 1px solid #ffd6e7;
    }
</style>


<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">

                <div class="chat-header d-flex justify-content-between align-items-center">
                    <span>Chat</span>
                    <a href="/Chat/Index" class="btn btn-light btn-sm">Back</a>
                </div>

                @if (ViewBag.ProductImage != null)
                {
                    <div class="system-product-box">
                        <img src="@ViewBag.ProductImage" style="width:70px;height:70px;object-fit:cover;border-radius:8px;" />
                        <div>
                            <div style="font-weight:600;">@ViewBag.ProductTitle</div>
                            <div class="text-danger fw-semibold">US $@ViewBag.Price</div>
                        </div>
                    </div>
                }

                <div class="card-body">

                    <div id="chatBox">
                        @foreach (var msg in Model)
                        {
                            if (msg.Content != "[system-product]")
                            {
                                var isMine = msg.SenderId == sender;
                                <div class="mb-3 @(isMine ? "text-end" : "text-start")">
                                    <div class="@(isMine ? "bubble-me" : "bubble-other")">
                                        @msg.Content
                                    </div>
                                    <div class="timestamp">@msg.Timestamp?.ToString("HH:mm dd/MM/yyyy")</div>
                                </div>
                            }
                        }
                    </div>

                    <div class="input-group mt-3 send-box">
                        <input id="msgInput" class="form-control" placeholder="Type a message..." maxlength="500" />
                        <button id="sendBtn" class="btn btn-primary">Send</button>
                    </div>

                    <div id="connectionStatus" class="mt-2 small text-muted">Connecting...</div>

                </div>
            </div>

        </div>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const senderId = @sender;
    const receiverId = @receiver;
    const room = "@room";

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", function (messageSenderId, messageReceiverId, message, time) {
        const isRelevant =
            (messageSenderId == senderId && messageReceiverId == receiverId) ||
            (messageSenderId == receiverId && messageReceiverId == senderId);

        if (isRelevant) appendMessage(messageSenderId, message, time);
    });

    function appendMessage(messageSenderId, message, time) {
        if (message === "[system-product]") return;

        const isMine = messageSenderId == senderId;
        const html = `
                <div class="mb-3 ${isMine ? "text-end" : "text-start"}">
                    <div class="${isMine ? "bubble-me" : "bubble-other"}">${message}</div>
                    <div class="timestamp">${time}</div>
                </div>
            `;

        document.getElementById("chatBox").insertAdjacentHTML("beforeend", html);
        scrollToBottom();
    }

    function scrollToBottom() {
        const box = document.getElementById("chatBox");
        box.scrollTop = box.scrollHeight;
    }

    function sendMessage() {
        const input = document.getElementById("msgInput");
        const msg = input.value.trim();

        if (!msg) return;

        document.getElementById("sendBtn").disabled = true;

        fetch("/Chat/SaveMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `senderId=${senderId}&receiverId=${receiverId}&content=${encodeURIComponent(msg)}`
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) return connection.invoke("SendMessage", room, senderId, receiverId, msg);
            })
            .then(() => {
                input.value = "";
                input.focus();
            })
            .finally(() => {
                document.getElementById("sendBtn").disabled = false;
            });
    }

    document.getElementById("sendBtn").onclick = sendMessage;
    document.getElementById("msgInput").addEventListener("keypress", e => {
        if (e.key === "Enter") sendMessage();
    });

    connection.start().then(() => {
        document.getElementById("connectionStatus").innerHTML = "<span class='text-success'>Connected</span>";
        connection.invoke("JoinRoom", room);
        scrollToBottom();
    });
</script>
