@{
    ViewData["Title"] = "Messages";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3> Messages</h3>
                <div id="onlineStatus" class="badge bg-secondary">
                    Checking connection...
                </div>
            </div>
            
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"> Conversations</h5>
                    <div id="productPreview" class="d-flex align-items-center ms-3" style="gap: 10px;">
                        <img id="previewImg" src="/uploads/products/648c1443-3fff-4ab1-8822-ebf0c0175ce6_kali-glitchsea.jpg" alt="Image" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px; display: none;">
                        <span id="previewPrice" class="fw-bold text-success" style="display: none;">3000000</span>
                    </div>
                    <button class="btn btn-success btn-sm" onclick="refreshConversations()">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
                <div class="card-body">
                    <div id="conversationsList">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div class="mt-2">Loading conversations...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    let signalRConnection = null;
    
    $(document).ready(function() {
        loadConversations();
        setupSignalR();
    });
    
    function setupSignalR() {
        signalRConnection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();
            
        signalRConnection.start()
            .then(function () {
                console.log("SignalR connected from Chat Index");
                $('#onlineStatus').removeClass('bg-secondary').addClass('bg-success').text(' Connected');
            })
            .catch(function (err) {
                console.error("SignalR connection error:", err);
                $('#onlineStatus').removeClass('bg-secondary').addClass('bg-danger').text(' Connection error');
            });
            
        signalRConnection.onreconnecting(() => {
            $('#onlineStatus').removeClass().addClass('badge bg-warning').text(' Reconnecting...');
        });
        
        signalRConnection.onreconnected(() => {
            $('#onlineStatus').removeClass().addClass('badge bg-success').text(' Reconnected');
        });
        
        signalRConnection.onclose(() => {
            $('#onlineStatus').removeClass().addClass('badge bg-danger').text(' Disconnected');
        });
    }
    
    function loadConversations() {
        $.get('/Chat/GetConversations')
            .done(function(response) {
                if (response.success && response.conversations && response.conversations.length > 0) {
                    let html = '';
                    response.conversations.forEach(function(conv) {
                        const time = new Date(conv.lastMessageTime).toLocaleString('en-US');
                        html += `
                            <div class="border rounded p-3 mb-3 conversation-item" style="cursor: pointer;" onclick="openChat(${conv.userId})">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-bold">${escapeHtml(conv.userName)}</h6>
                                        <p class="text-muted mb-2 small">${escapeHtml(conv.lastMessage)}</p>
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i> ${time}
                                        </small>
                                    </div>
                                    <div class="ms-3">
                                        <button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); openChat(${conv.userId})">
                                            <i class="bi bi-chat-dots"></i> Open chat
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    $('#conversationsList').html(html);
                } else {
                    $('#conversationsList').html(`
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-chat-dots fs-1 text-secondary"></i>
                                <h5 class="mt-3">No conversations yet</h5>
                                <p class="text-muted">You'll see messages here when someone sends you a message.</p>
                            </div>
                        </div>
                    `);
                }
            })
            .fail(function(xhr) {
                let errorMessage = 'Unknown error';
                if (xhr.status === 401) {
                    errorMessage = 'You need to log in to view messages';
                } else if (xhr.status === 500) {
                    errorMessage = 'Server error';
                }
                
                $('#conversationsList').html(`
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Error loading conversations: ${errorMessage}
                    </div>
                `);
            });
    }
    
    function refreshConversations() {
        $('#conversationsList').html(`
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Refreshing...</span>
                </div>
                <div class="mt-2">Refreshing...</div>
            </div>
        `);
        loadConversations();
    }
    
    function openChat(userId) {
        window.location.href = `/Chat/Thread?receiverId=${userId}`;
    }
    
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    

    $(document).on('mouseenter', '.conversation-item', function() {
        $(this).addClass('bg-light shadow-sm');
    }).on('mouseleave', '.conversation-item', function() {
        $(this).removeClass('bg-light shadow-sm');
    });
</script>

<style>
    .conversation-item {
        transition: all 0.2s ease;
        border: 1px solid #dee2e6;
    }
    
    .conversation-item:hover {
        border-color: #007bff !important;
        transform: translateY(-1px);
    }
</style>