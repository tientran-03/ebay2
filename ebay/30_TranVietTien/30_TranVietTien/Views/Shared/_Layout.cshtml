@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eBay Clone</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #fff;
        }

        .top-banner {
            background-color: #f8f8f8;
            font-size: 14px;
            padding: 6px 20px;
            display: flex;
            justify-content: space-between;
        }

            .top-banner a {
                text-decoration: none;
                color: #0073e6;
            }

        .navbar {
            border-bottom: 1px solid #e6e6e6;
            background: #fff;
            padding: 10px 20px;
        }

        .navbar-brand img {
            height: 36px;
        }

        .search-box input {
            width: 60%;
            border-radius: 0;
        }

        .search-box select, .search-box button {
            border-radius: 0;
        }

        .search-box button {
            background-color: #3665f3;
            border-color: #3665f3;
        }

            .search-box button:hover {
                background-color: #274bc0;
            }

        .category-links a {
            margin: 0 10px;
            color: #333;
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
        }

            .category-links a:hover {
                color: #0073e6;
            }

        footer {
            background-color: #f5f5f5;
            font-size: 14px;
            padding: 40px 0;
        }

            footer h6 {
                font-weight: 600;
                font-size: 15px;
                margin-bottom: 12px;
            }

            footer a {
                color: #333;
                text-decoration: none;
                display: block;
                margin-bottom: 6px;
            }

                footer a:hover {
                    text-decoration: underline;
                }

        .country-selector {
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 5px 10px;
            display: inline-flex;
            align-items: center;
        }

        @@media (max-width: 768px) {
            .search-box input {
                width: 100%;
            }
        }

        main {
            overflow: visible !important;
            position: static !important;
        }

        .dropdown-menu {
            z-index: 99999 !important;
        }

    </style>
</head>

<body>
    @{
        var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
        var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    }

    <div class="top-banner">
        <div>
            @if (string.IsNullOrEmpty(username))
            {
                <span>
                    G'day! <a asp-controller="Account" asp-action="Login">Sign in</a>
                    or <a asp-controller="Account" asp-action="Register">register</a>
                </span>
            }
            else
            {
                <span>
                    Welcome, <strong>@username</strong> |
                    <a asp-controller="Account" asp-action="Logout" class="text-danger">Logout</a>
                </span>
            }
        </div>
        <div>
            <a href="#">Today's Deals</a> |
            <a href="#">Help & Contact</a>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid align-items-center">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="https://upload.wikimedia.org/wikipedia/commons/1/1b/EBay_logo.svg" alt="eBay">
            </a>

            <div class="d-flex search-box mx-auto align-items-center">
                <form asp-controller="Home" asp-action="Index" method="get" class="d-flex w-100">
                    <input class="form-control mx-1" type="text" name="q" placeholder="Search for product or shop..." />
                    <select class="form-select w-auto me-1" name="cat">
                        <option value="">All Categories</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                    <button class="btn btn-primary ms-1" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <ul class="navbar-nav ms-auto align-items-center">
                @if (string.IsNullOrEmpty(username))
                {
                    <li class="nav-item me-3">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-person fs-5"></i> Login
                        </a>
                    </li>
                    <li class="nav-item me-3">
                        <a class="nav-link" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus fs-5"></i> Register
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item me-3">
                    </li>
                    <li class="nav-item dropdown me-3">
                        <a class="nav-link dropdown-toggle fw-semibold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> @username
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" asp-controller="Order" asp-action="History"><i class="bi bi-clock-history me-2"></i> My Orders</a></li>
                            <li><a class="dropdown-item" asp-controller="Address" asp-action="Index"><i class="bi bi-geo-alt me-2"></i> My Addresses</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                }

                <li class="nav-item me-3">
                    <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="ms-1">Cart</span>
                        <span id="cartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">0</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="category-links text-center border-bottom py-2">
        <a href="#">eBay Live</a>
        <a href="#">Saved</a>
        <a href="#">Electronics</a>
        <a href="#">Motors</a>
        <a href="#">Fashion</a>
        <a href="#">Collectibles</a>
        <a href="#">Sports</a>
        <a href="#">Health & Beauty</a>
        <a href="#">Home & Garden</a>
        <a href="#">Deals</a>
    </div>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row text-start">
                <div class="col-md-3">
                    <h6>Buy</h6>
                    <a href="#">eBay Deals</a>
                    <a href="#">Gift Finder</a>
                    <a href="#">Charity</a>
                    <a href="#">eBay Mobile</a>
                </div>
                <div class="col-md-3">
                    <h6>Sell</h6>
                    <a href="#">Start Selling</a>
                    <a href="#">Fees</a>
                    <a href="#">Business Sellers</a>
                </div>
                <div class="col-md-3">
                    <h6>Stay Connected</h6>
                    <a href="#"><i class="bi bi-facebook me-1"></i> Facebook</a>
                    <a href="#"><i class="bi bi-twitter me-1"></i> Twitter</a>
                    <a href="#"><i class="bi bi-instagram me-1"></i> Instagram</a>
                </div>
                <div class="col-md-3">
                    <h6>About eBay</h6>
                    <a href="#">Company Info</a>
                    <a href="#">Advertise</a>
                    <a href="#">Careers</a>
                    <a href="#">Privacy</a>
                </div>
            </div>
            <div class="text-center mt-4">
                <div class="country-selector">
                    <img src="https://flagcdn.com/16x12/us.png" alt="US" class="me-1">
                    United States
                </div>
                <p class="mt-3 mb-0 text-muted small">Copyright © 2025 eBay Clone. All rights reserved.</p>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
