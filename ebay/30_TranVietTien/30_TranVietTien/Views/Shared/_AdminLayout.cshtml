@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            color: #333;
        }
        .admin-header {
            background: #ffffff;
            color: #333;
            padding: 1rem 0;
            border-bottom: 1px solid #e5e5e5;
        }
        .admin-nav {
            background-color: #ffffff;
            border-bottom: 1px solid #e5e5e5;
            padding: 0.5rem 0;
        }

            .admin-nav .nav-link {
                color: #333;
                font-weight: 500;
                padding: 0.6rem 1.2rem;
                border-radius: 8px;
                margin: 0 0.25rem;
                transition: 0.2s ease;
            }

                .admin-nav .nav-link:hover {
                    background-color: #f2f2f2;
                    color: #000;
                }

                .admin-nav .nav-link.active {
                    background-color: #000;
                    color: white !important;
                }
        .main-content {
            padding: 2rem 0;
        }

        .page-header {
            background: white;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border: 1px solid #eee;
        }
        .stats-card {
            background: white;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            border: 1px solid #eee;
            transition: 0.2s ease;
        }

            .stats-card:hover {
                transform: translateY(-1px);
                border-color: #ddd;
            }

        .stats-icon {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            background-color: #f5f5f5;
            color: #333;
        }

        .admin-footer {
            background-color: #ffffff;
            border-top: 1px solid #e5e5e5;
            padding: 2rem 0;
            margin-top: 3rem;
        }
        .breadcrumb {
            background: none;
            padding: 0;
        }

        @@media (max-width: 768px) {
            .admin-nav .nav-link {
                padding: 0.45rem 1rem;
                font-size: 0.9rem;
            }
        }
    </style>

</head>

<body>
    @{
        var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <header class="admin-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h4 class="mb-0">
                        <i class="bi bi-speedometer2 me-2"></i>
                        Admin Dashboard
                    </h4>
                    <small class="opacity-75">Welcome back, @username</small>
                </div>

                <div class="col-md-6 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">

                        <div class="dropdown ms-2">
                            <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle text-dark"></i>
                                <span class="d-none d-lg-inline ms-1 text-dark">@username</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Admin/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" href="/Home/Index"><i class="bi bi-house me-2"></i>Go to Store</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </header>
    <nav class="admin-nav">
        <div class="container">
            <ul class="nav nav-pills justify-content-center">

                <li class="nav-item">
                    <a class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")"
                       href="/Admin/Dashboard">
                        <i class="bi bi-speedometer me-1"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "AdminProduct" ? "active" : "")"
                       href="/AdminProduct">
                        <i class="bi bi-box-seam me-1"></i> Products
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "AdminOrder" ? "active" : "")"
                       href="/OrderAdmin">
                        <i class="bi bi-receipt me-1"></i> Orders
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "AdminUser" ? "active" : "")"
                       href="/AdminUser">
                        <i class="bi bi-people me-1"></i> Users
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "AdminCategory" ? "active" : "")"
                       href="/Categories"
                        <i class="bi bi-tags me-1"></i> Categories
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "AdminReport" ? "active" : "")"
                       href="/AdminDashboard">
                        <i class="bi bi-graph-up me-1"></i> Reports
                    </a>
                </li>

            </ul>
        </div>
    </nav>
    <main class="main-content">
        <div class="container">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </nav>

            @RenderBody()
        </div>
    </main>
    <footer class="admin-footer">
        <div class="container">
            <p class="text-center text-muted small mb-0">
                © 2025 Admin System – All rights reserved.
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
