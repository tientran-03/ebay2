@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seller Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #ffffff;
        color: #333;
    }

    /* Header */
    .seller-header {
        background: #ffffff;
        color: #333;
        padding: 1rem 0;
        border-bottom: 1px solid #e5e5e5;
    }

    /* Navigation */
    .seller-nav {
        background-color: #ffffff;
        border-bottom: 1px solid #e5e5e5;
        padding: 0.5rem 0;
    }

    .seller-nav .nav-link {
        color: #333;
        font-weight: 500;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        margin: 0 0.25rem;
        transition: 0.2s ease;
    }

    .seller-nav .nav-link:hover {
        background-color: #f2f2f2;
        color: #000;
    }

    .seller-nav .nav-link.active {
        background-color: #000;
        color: white;
    }

    /* Main content */
    .main-content {
        padding: 2rem 0;
    }

    .page-header {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid #eee;
    }

    /* Stats card */
    .stats-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #eee;
        transition: 0.2s ease;
    }

    .stats-card:hover {
        transform: translateY(-1px);
        border-color: #ddd;
    }

    .stats-icon {
        width: 45px;
        height: 45px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        background-color: #f5f5f5;
        color: #333;
    }

    /* Footer */
    .seller-footer {
        background-color: #ffffff;
        border-top: 1px solid #e5e5e5;
        padding: 2rem 0;
        margin-top: 3rem;
    }

    /* Breadcrumb */
    .breadcrumb {
        background: none;
        padding: 0;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        color: #999;
    }

    @@media (max-width: 768px) {
        .seller-nav .nav-link {
            padding: 0.45rem 1rem;
            font-size: 0.9rem;
        }
    }
</style>

</head>

<body>
    @{
        var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- Seller Header -->
    <header class="seller-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h4 class="mb-0">
                        <i class="bi bi-shop me-2"></i>
                        Seller Dashboard
                    </h4>
                    <small class="opacity-75">Welcome back, @username</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">
                        <a href="/Chat/Index" class="btn btn-outline-light btn-sm me-2" title="Messages">
                            <i class="bi bi-chat-dots text-dark"></i>
                            <span class="d-none d-lg-inline ms-1 text-dark">Messages</span>
                        </a>

                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle text-dark"></i>
                                <span class="d-none d-lg-inline ms-1  text-dark">@username</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" href="/StoreSeller"><i class="bi bi-house me-2"></i>Store Manager</a></li>
                                <li><a class="dropdown-item" href="/Home/Index"><i class="bi bi-house me-2"></i>Go to Store</a></li>
                           
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <nav class="seller-nav">
        <div class="container">
            <ul class="nav nav-pills justify-content-center">
                <li class="nav-item">
                    <a class="nav-link @((currentController == "SellerProduct" && currentAction == "Dashboard") ? "active" : "")" 
                       href="/SellerProduct/Dashboard">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @((currentController == "SellerProduct" && currentAction == "Index") ? "active" : "")" 
                       href="/SellerProduct">
                        <i class="bi bi-box-seam me-1"></i>Products
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "SellerOrder" ? "active" : "")" 
                       href="/SellerOrder">
                        <i class="bi bi-receipt me-1"></i>Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "SellerCoupon" ? "active" : "")" 
                       href="/SellerCoupon">
                        <i class="bi bi-tag me-1"></i>Coupons
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "SellerDispute" ? "active" : "")" 
                       href="/SellerDispute">
                        <i class="bi bi-exclamation-triangle me-1"></i>Disputes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "SellerReturn" ? "active" : "")"
                       href="/SellerReturn">
                        <i class="bi bi-arrow-return-left me-1"></i>Returns
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Report" ? "active" : "")" 
                       href="/Report/Monthly">
                        <i class="bi bi-graph-up me-1"></i>Reports
                    </a>
                </li>
            </ul>
        </div>
    </nav>
    <main class="main-content">
        <div class="container">
            <!-- Breadcrumb -->
            @if (ViewBag.ShowBreadcrumb != false)
            {
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/SellerProduct/Dashboard">Dashboard</a></li>
                        @if (ViewBag.BreadcrumbItems != null)
                        {
                            @foreach (var item in ViewBag.BreadcrumbItems as List<dynamic>)
                            {
                                if (item.IsActive)
                                {
                                    <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
                                }
                                else
                                {
                                    <li class="breadcrumb-item"><a href="@item.Url">@item.Text</a></li>
                                }
                            }
                        }
                        else if (!(currentController == "SellerProduct" && currentAction == "Dashboard"))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        }
                    </ol>
                </nav>
            }

            @RenderBody()
        </div>
    </main>
    <footer class="seller-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h6>Seller Resources</h6>
                    <div class="row">
                        <div class="col-6">
                            <a href="#" class="text-decoration-none text-muted small d-block mb-1">Seller Help</a>
                            <a href="#" class="text-decoration-none text-muted small d-block mb-1">Fees & Policies</a>
                            <a href="#" class="text-decoration-none text-muted small d-block mb-1">Shipping Guide</a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="text-decoration-none text-muted small d-block mb-1">Best Practices</a>
                            <a href="#" class="text-decoration-none text-muted small d-block mb-1">Marketing Tools</a>
                            <a href="#" class="text-decoration-none text-muted small d-block mb-1">Analytics</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <h6>Support</h6>
                    <p class="text-muted small mb-1">Need help? Contact our seller support team</p>
                    <p class="text-muted small mb-0">Monday - Friday, 9AM - 5PM</p>
                </div>
            </div>
            <hr class="my-3">
            <div class="text-center">
                <p class="text-muted small mb-0">© 2025 eBay Clone - Seller Dashboard. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>