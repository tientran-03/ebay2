@model IEnumerable<User>
@{
    Layout = "_AdminLayout";
}
<h2>Users</h2>

<table class="table">
    <tr><th>Email</th><th>Username</th><th>Role</th><th>Action</th></tr>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Email</td>
            <td>@u.Username</td>
            <td>@u.Role</td>
            <td><a href="/UserAdmin/ToggleLock/@u.Id">Toggle Lock</a></td>
        </tr>
    }
</table>
