@model IEnumerable<_30_TranVietTien.Models.Address>

@{
    ViewData["Title"] = "My Addresses";
    Layout = "_Layout";
}

<style>
    .card-clean {
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        transition: 0.2s;
        background: white;
    }

        .card-clean:hover {
            border-color: #ccc;
        }

    .btn-clean {
        border: 1px solid black;
        background: white;
        color: black;
        transition: 0.15s;
    }

        .btn-clean:hover {
            background: black;
            color: white;
        }

    .badge-clean {
        border: 1px solid black;
        background: white;
        color: black;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 5px;
    }
</style>

<div class="container py-5">
    @if (Model != null && Model.Any())
    {
        <div class="row g-3">
            @foreach (var addr in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-clean p-3 h-100">

                        <h5 class="mb-1">@addr.FullName</h5>
                        <div class="small">@addr.Phone</div>

                        <div class="text-muted small mb-2">
                            @addr.Street, @addr.City, @addr.State, @addr.Country
                        </div>

                        @if (addr.IsDefault == true)
                        {
                            <span class="badge-clean">Default</span>
                        }

                        <div class="mt-3 d-flex gap-2">
                            <form asp-controller="Address" asp-action="SetDefault" method="post">
                                <input type="hidden" name="id" value="@addr.Id" />
                                <button type="submit" class="btn btn-clean btn-sm"
                                @(addr.IsDefault == true ? "disabled" : "")>
                                    Set Default
                                </button>
                            </form>

                            <button class="btn btn-clean btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal@addr.Id">
                                Edit
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="editModal@addr.Id">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">Edit Address</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <form asp-controller="Address" asp-action="Update" method="post">
                                <div class="modal-body">

                                    <input type="hidden" name="Id" value="@addr.Id" />

                                    <div class="mb-2">
                                        <label class="form-label">Full Name</label>
                                        <input type="text" name="FullName" class="form-control" value="@addr.FullName" required />
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label">Phone</label>
                                        <input type="text" name="Phone" class="form-control" value="@addr.Phone" required />
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label">Street</label>
                                        <input type="text" name="Street" class="form-control" value="@addr.Street" required />
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label">City</label>
                                        <input type="text" name="City" class="form-control" value="@addr.City" required />
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label">State</label>
                                        <input type="text" name="State" class="form-control" value="@addr.State" />
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label">Country</label>
                                        <input type="text" name="Country" class="form-control" value="@addr.Country" />
                                    </div>

                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                        Cancel
                                    </button>
                                    <button type="submit" class="btn btn-clean">
                                        Save Changes
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            You have no saved addresses yet.
        </div>
    }

    <hr class="my-5" />

    <div class="card-clean p-4">
        <h5 class="mb-3">Add New Address</h5>

        <form asp-controller="Address" asp-action="Create" method="post">
            <div class="row g-2">

                <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="FullName" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone</label>
                    <input type="text" name="Phone" class="form-control" required />
                </div>

                <div class="col-md-12">
                    <label class="form-label">Street</label>
                    <input type="text" name="Street" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label">City</label>
                    <input type="text" name="City" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label">State</label>
                    <input type="text" name="State" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Country</label>
                    <input type="text" name="Country" class="form-control" required />
                </div>

                <div class="col-md-12 mt-2">
                    <input type="checkbox" name="setDefault" id="setDefault" class="form-check-input" />
                    <label class="form-check-label ms-1" for="setDefault">Set as default</label>
                </div>
            </div>

            <button type="submit" class="btn btn-clean mt-3 px-4">
                Save Address
            </button>
        </form>
    </div>

</div>
