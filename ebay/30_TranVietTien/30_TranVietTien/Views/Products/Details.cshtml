@model _30_TranVietTien.Models.Product
@using _30_TranVietTien.ViewModels.Cart
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row g-4">
        <!-- Product Image -->
        <div class="col-md-6 text-center">
            <img src="@Model.Images" class="img-fluid rounded border" alt="@Model.Title" />
        </div>

        <!-- Product Info -->
        <div class="col-md-6">
            <h3 class="fw-bold mb-2">@Model.Title</h3>
            <p class="text-muted mb-1">Category: @Model.Category?.Name</p>
            <h2 class="text-danger fw-semibold mb-3">$@Model.Price</h2>
            <p class="mb-3">@Model.Description</p>

            <!-- Buttons -->
            <div class="d-grid gap-2 mb-4">
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="name" value="@Model.Title" />
                    <input type="hidden" name="price" value="@Model.Price" />
                    <input type="hidden" name="image" value="@Model.Images" />
                    <button class="btn btn-outline-dark w-100">Add to Cart</button>
                </form>

                <form asp-controller="Order" asp-action="BuyNow" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-dark w-100">Buy Now</button>
                </form>

                <button class="btn btn-outline-secondary w-100">Add to Wishlist</button>
            </div>

            <!-- Seller Info -->
            <div class="small text-muted">
                <p><i class="bi bi-shop"></i> Seller: <strong>@Model.Seller?.Username</strong></p>
                <p><i class="bi bi-geo-alt"></i> Shipping from: Thai Nguyen, Thai Nguyen</p>
                <p><i class="bi bi-cash-coin"></i> Payment: PayPal, VISA, MasterCard</p>
            </div>

            <button class="btn btn-outline-dark w-100 mt-3" onclick="openChat(@Model.SellerId, @Model.Id)">Contact Seller</button>
        </div>
    </div>

    <!-- Chat Modal -->
    <div class="modal fade" id="chatModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0">
                <div class="modal-header">
                    <h5 class="modal-title">Chat with Seller</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe id="chatFrame" style="width:100%;height:500px;border:0;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <!-- Reviews -->
    <div class="row">
        <div class="col-md-8">
            <h4 class="fw-bold mb-3">Customer Reviews</h4>
            <div id="reviewList">
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <div class="border-bottom pb-2 mb-3">
                            <strong>@review.Reviewer?.Username</strong>
                            <p class="mb-1">@review.Comment</p>
                            <small class="text-muted">@review.CreatedAt?.ToShortDateString()</small>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No reviews yet.</p>
                }
            </div>

            @if (Context.Session.GetString("Username") != null)
            {
                <form asp-controller="Review" asp-action="Create" method="post" class="mt-3">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <label class="form-label fw-semibold">Rating</label>
                    <select name="rating" class="form-select w-auto d-inline-block mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option>@i</option>
                        }
                    </select>
                    <textarea name="comment" class="form-control mb-2" placeholder="Write your review..." required></textarea>
                    <button class="btn btn-dark rounded-pill">Submit Review</button>
                </form>
            }
            else
            {
                <p><a asp-controller="Account" asp-action="Login">Login</a> to leave a review.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const productId = "@Model.Id";
        const reviewConnection = new signalR.HubConnectionBuilder().withUrl("/reviewHub").build();
        reviewConnection.start().then(() => reviewConnection.invoke("JoinProductGroup", productId));
        reviewConnection.on("ReceiveReview", r => {
            const list = document.getElementById("reviewList");
            const div = document.createElement("div");
            div.classList.add("border-bottom", "pb-2", "mb-3");
            div.innerHTML = `<strong>${r.reviewer}</strong>
                                     <p class="mb-1">${r.comment}</p>
                                     <small class="text-muted">${r.createdAt}</small>`;
            list.prepend(div);
        });
    </script>

    <script>
        function openChat(sellerId, productId) {
            const buyerId = '@Context.Session.GetInt32("UserId")';
            if (!buyerId) {
                alert("Please log in to chat with the seller.");
                return;
            }

            const url = `/Chat/Thread?receiverId=${sellerId}&productId=${productId}`;
            document.getElementById("chatFrame").src = url;

            const modal = new bootstrap.Modal(document.getElementById('chatModal'));
            modal.show();
        }

    </script>
}
