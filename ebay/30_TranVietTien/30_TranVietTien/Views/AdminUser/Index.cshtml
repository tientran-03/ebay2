@model IEnumerable<_30_TranVietTien.Models.User>
@{
    Layout = "_AdminLayout";
}
<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Lock/Unlock</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Username</td>
                <td>@u.Email</td>
                <td>@u.Role</td>

                <td>
                    <form asp-action="ToggleLock" method="post">
                        <input type="hidden" name="id" value="@u.Id" />

                        @if (u.Role == "Locked")
                        {
                            <button class="btn btn-dark btn-sm">Unlock</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-dark btn-sm">Lock</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
