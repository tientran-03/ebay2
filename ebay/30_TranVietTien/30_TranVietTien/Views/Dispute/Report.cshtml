@model _30_TranVietTien.Models.OrderTable

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container py-4" style="max-width:950px;">
    <div class="d-flex border p-3 rounded mb-4">
        <img src="@Model.OrderItems.First().Product.Images?.Split(',')[0]"
             style="width:120px;height:120px;object-fit:contain;border:1px solid #eee;padding:5px;" />

        <div class="ms-3">
            <h5>@Model.OrderItems.First().Product.Title</h5>
            <div class="text-muted">Item price: <strong>US $@Model.OrderItems.First().UnitPrice</strong></div>
            <div class="text-muted">Item number: @Model.OrderItems.First().Product.Id</div>
        </div>
    </div>

    <h5>Select a topic</h5>

    <form asp-controller="Dispute" asp-action="Create" method="post">

        <input type="hidden" name="orderId" value="@Model.Id" />

        <div class="border p-3 rounded mb-4">

            <div class="form-check">
                <input class="form-check-input" type="radio" name="reason" value="I have a question about using my item" required />
                <label class="form-check-label">I have a question about using my item</label>
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="radio" name="reason" value="I didn't receive my item" />
                <label class="form-check-label">I didn’t receive my item</label>
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="radio" name="reason" value="I need to return my item" />
                <label class="form-check-label">I need to return my item</label>
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="radio" name="reason" value="I received an item that wasn't as described" />
                <label class="form-check-label">I received an item that wasn’t as described</label>
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="radio" name="reason" value="Request to cancel the order" />
                <label class="form-check-label">Request to cancel this order</label>
            </div>
        </div>

        <h5>Describe your issue</h5>

        <textarea name="description" class="form-control mb-4" rows="4"
                  placeholder="Provide more details to help the seller understand your issue..."
                  required></textarea>
        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-primary px-4">Contact the seller</button>
            <a asp-controller="Order" asp-action="History" class="btn btn-light border">Go back</a>
        </div>

    </form>

</div>
