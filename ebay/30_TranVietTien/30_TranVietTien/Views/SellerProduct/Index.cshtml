@model IEnumerable<_30_TranVietTien.Models.Product>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Product Management";
    Layout = "_SellerLayout";
    var categories = ViewBag.Categories as List<_30_TranVietTien.Models.Category>;
}

<style>
    .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
    }

    #toastContainer {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 2000;
    }

    .qty {
        font-weight: bold;
        color: #2b9348;
    }

    .out {
        color: #c1121f;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1">Product Management</h4>
            <p class="text-muted mb-0">Manage your products and inventory</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productModal" onclick="clearForm()">
            <i class="bi bi-plus-circle me-1"></i>Add Product
        </button>
    </div>
</div>

<!-- Products Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="productTable">
                    @foreach (var p in Model)
                    {
                        var inv = p.Inventories?.FirstOrDefault();
                        <tr id="row-@p.Id">
                            <td>
                                @if (!string.IsNullOrEmpty(p.Images))
                                {
                                    <img src="@p.Images" class="product-img border" />
                                }
                                else
                                {
                                    <span class="text-muted small">No image</span>
                                }
                            </td>
                            <td class="fw-semibold">@p.Title</td>
                            <td>@p.Category?.Name</td>
                            <td class="fw-bold text-success">@p.Price?.ToString("N0") ₫</td>
                            <td>
                                @if (inv != null)
                                {
                                    <span class="qty">@inv.Quantity</span>
                                }
                                else
                                {
                                    <span class="out">None</span>
                                }
                            </td>
                            <td class="text-muted small">@p.Description</td>
                            <td>
                                <button class="btn btn-outline-primary btn-sm me-1" onclick="editProduct(@p.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" onclick="deleteProduct(@p.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="toastContainer" aria-live="polite" aria-atomic="true"></div>

<!-- Product Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="productForm" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="productModalLabel">Add / Edit Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="Id" id="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input class="form-control" name="Title" id="Title" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Price (₫)</label>
                            <input type="number" step="0.01" class="form-control" name="Price" id="Price" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Stock</label>
                            <input type="number" class="form-control" name="Quantity" id="Quantity" required min="0" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="Description" id="Description" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <select class="form-select" name="CategoryId" id="CategoryId" required>
                                <option value="">-- Select category --</option>
                                @if (categories != null)
                                {
                                    foreach (var c in categories)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Image</label>
                            <input type="file" class="form-control" name="image" id="image" />
                            <img id="previewImg" src="#" class="mt-2 d-none border rounded" width="120" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    function clearForm() {
        $("#Id, #Title, #Description, #Price, #CategoryId, #Quantity").val('');
        $("#image").val('');
        $("#previewImg").addClass("d-none");
    }

    $("#image").on("change", function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = e => $("#previewImg").attr("src", e.target.result).removeClass("d-none");
            reader.readAsDataURL(file);
        }
    });

    function editProduct(id) {
        $.get(`/SellerProduct/GetProduct/${id}`, function (res) {
            if (!res || !res.success) return showToast("Product not found!", "danger");
            $("#Id").val(res.id);
            $("#Title").val(res.title);
            $("#Description").val(res.description);
            $("#Price").val(res.price);
            $("#CategoryId").val(res.categoryId);
            $("#Quantity").val(res.quantity || 0);
            if (res.image) $("#previewImg").attr("src", res.image).removeClass("d-none");
            $("#productModal").modal("show");
        });
    }

    function deleteProduct(id) {
        if (!confirm("Are you sure you want to delete this product?")) return;
        $.post('/SellerProduct/Delete', { id: id }, function (res) {
            if (res.success) {
                $(`#row-${id}`).fadeOut();
                showToast("Product deleted successfully!", "success");
            } else {
                showToast(res.message || "Unable to delete product!", "danger");
            }
        });
    }

    $("#productForm").on("submit", function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const id = $("#Id").val();
        const url = id ? '/SellerProduct/Edit' : '/SellerProduct/Create';

        $.ajax({
            url: url,
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    $("#productModal").modal("hide");
                    showToast("Product saved successfully!", "success");
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast("Error saving product!", "danger");
                }
            },
            error: function () {
                showToast("Server error!", "danger");
            }
        });
    });

    function showToast(message, type) {
        const bg = type === "success" ? "bg-success" : type === "danger" ? "bg-danger" : "bg-info";
        const toast = $(`
                <div class="toast text-white ${bg} border-0">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `);
        $("#toastContainer").append(toast);
        new bootstrap.Toast(toast[0], { delay: 2500 }).show();
        toast.on('hidden.bs.toast', () => toast.remove());
    }

    // SignalR Chat notifications
    const sellerId = '@HttpContextAccessor.HttpContext.Session.GetInt32("UserId")';
    const chatConnection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    chatConnection.on("ReceiveMessage", (sender, receiver, content, time) => {
        if (receiver == sellerId) {
            showToast(`New message from user ${sender}`, "info");
            // Optional: redirect to chat
            // window.location.href = `/Chat/Thread?receiverId=${sender}`;
        }
    });

    chatConnection.start().catch(err => console.error("SignalR Error:", err));
</script>
}
