@{
    ViewData["Title"] = "Dashboard";
    Layout = "_SellerLayout";
}

<!-- Dashboard Stats -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon primary me-3">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h5 class="mb-1">@ViewBag.ProductCount</h5>
                    <p class="text-muted mb-0 small">Total Products</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon success me-3">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <h5 class="mb-1">@ViewBag.OrderCount</h5>
                    <p class="text-muted mb-0 small">Total Orders</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon warning me-3">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <h5 class="mb-1">@ViewBag.DisputeCount</h5>
                    <p class="text-muted mb-0 small">Active Disputes</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon danger me-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <h5 class="mb-1">@ViewBag.Revenue?.ToString("N0") ?</h5>
                    <p class="text-muted mb-0 small">Total Revenue</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="page-header mb-4">
    <h5 class="mb-3">Quick Actions</h5>
    <div class="row">
        <div class="col-md-3 mb-3">
            <a href="/SellerProduct" class="btn btn-outline-primary w-100 py-3">
                <i class="bi bi-plus-circle fs-4 d-block mb-2"></i>
                Add Product
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/SellerOrder" class="btn btn-outline-success w-100 py-3">
                <i class="bi bi-list-check fs-4 d-block mb-2"></i>
                Manage Orders
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/SellerCoupon" class="btn btn-outline-warning w-100 py-3">
                <i class="bi bi-tag fs-4 d-block mb-2"></i>
                Create Coupon
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a href="/Chat/Index" class="btn btn-outline-info w-100 py-3">
                <i class="bi bi-chat-dots fs-4 d-block mb-2"></i>
                Messages
            </a>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Recent Orders</h6>
            </div>
            <div class="card-body">
                @if (ViewBag.RecentOrders != null && ((IEnumerable<dynamic>)ViewBag.RecentOrders).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in ViewBag.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold">ORD@($"{order.Id:D5}")</td>
                                        <td>@order.Buyer?.Username</td>
                                        <td><span class="badge bg-secondary">@order.Status</span></td>
                                        <td>@order.TotalPrice</td>
                                        <td class="small">@order.OrderDate?.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                        <p class="text-muted">No recent orders</p>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Low Stock Alert</h6>
            </div>
            <div class="card-body">
                @if (ViewBag.LowStockProducts != null && ((IEnumerable<dynamic>)ViewBag.LowStockProducts).Any())
                {
                    @foreach (var product in ViewBag.LowStockProducts)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                            <div class="flex-grow-1">
                                <div class="small fw-semibold">@product.Title</div>
                                <div class="small text-muted">Only @product.Stock left</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-check-circle fs-1 text-success"></i>
                        <p class="text-muted">All products in stock</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>