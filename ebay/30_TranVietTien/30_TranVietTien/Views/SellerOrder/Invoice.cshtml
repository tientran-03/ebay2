@model _30_TranVietTien.Models.OrderTable
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Phiếu vận chuyển</title>
    <style>
        body {
            font-family: Arial;
            margin: 40px;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        .total {
            text-align: right;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h2>PHIẾU VẬN CHUYỂN</h2>
    <p><b>Mã đơn hàng:</b> ORD@Model.Id</p>
    <p><b>Khách hàng:</b> @Model.Buyer?.Username</p>
    <p><b>Địa chỉ:</b> @Model.Address?.Street, @Model.Address?.City</p>
    <p><b>Ngày đặt:</b> @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>

    <table>
        <thead>
            <tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model.OrderItems)
            {
                <tr>
                    <td>@i.Product?.Title</td>
                    <td>@i.Quantity</td>
                    <td>@i.UnitPrice?.ToString("N0") ₫</td>
                    <td>@((i.Quantity * i.UnitPrice)?.ToString("N0")) ₫</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="total">Tổng tiền: @Model.TotalPrice?.ToString("N0") ₫</p>
</body>
</html>
