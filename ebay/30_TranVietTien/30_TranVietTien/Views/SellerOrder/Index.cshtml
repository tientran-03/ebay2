@model IEnumerable<_30_TranVietTien.Models.OrderTable>

@{
    ViewData["Title"] = "Order Management";
    Layout = "_SellerLayout";
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1">Order Management</h4>
            <p class="text-muted mb-0">Manage and track customer orders</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-primary">@Model.Count() Total Orders</span>
            <span class="badge bg-success">@Model.Count(o => o.Status == "Delivered") Delivered</span>
            <span class="badge bg-warning">@Model.Count(o => o.Status == "Pending") Pending</span>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted"></i>
        <h5 class="mt-3">No orders found</h5>
        <p class="text-muted">Orders will appear here when customers make purchases.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Shipping Address</th>
                            <th>Products</th>
                            <th>Coupon</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            var coupon = o.OrderItems.FirstOrDefault()?.Product?.Coupons?.FirstOrDefault();
                            <tr>
                                <td class="fw-bold">@($"ORD{o.Id:D5}")</td>
                                <td>
                                    <div class="fw-semibold">@o.Buyer?.Username</div>
                                    <div class="text-muted small">@o.Buyer?.Email</div>
                                    <div class="text-muted small">@o.Buyer?.Addresses?.FirstOrDefault()?.Phone</div>
                                </td>
                                <td class="text-start">
                                    @if (o.Address != null)
                                    {
                                        <div><b>@o.Address.FullName</b></div>
                                        <div>@o.Address.Street</div>
                                        <div>@o.Address.City, @o.Address.State</div>
                                        <div class="text-muted small">@o.Address.Phone</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No address</span>
                                    }
                                </td>
                                <td class="text-start">
                                    @foreach (var item in o.OrderItems)
                                    {
                                        <div class="small">@item.Product?.Title × @item.Quantity</div>
                                    }
                                </td>
                                <td>
                                    @if (coupon != null)
                                    {
                                        <span class="badge bg-success">@coupon.Code</span>
                                        <br />
                                        <small class="text-success">@coupon.DiscountPercent% off</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td class="fw-semibold text-success">@o.TotalPrice?.ToString("N0") ₫</td>
                                <td>
                                    @{ 
                                        var statusClass = o.Status switch
                                        {
                                            "Pending" => "bg-warning",
                                            "Processing" => "bg-info",
                                            "Shipped" => "bg-primary",
                                            "Delivered" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        }; 
                                    }
                                    <span class="badge @statusClass">@o.Status</span>
                                </td>
                                <td>
                                    @if (o.Payments?.Any() == true)
                                    {
                                        var pay = o.Payments.First();
                                        <span class="fw-semibold">@pay.Method</span>
                                        <br />
                                        <small class="text-muted">@pay.Status</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not paid</span>
                                    }
                                </td>
                                <td class="small">@o.OrderDate?.ToString("HH:mm dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group-vertical gap-1">
                                        <button class="btn btn-outline-primary btn-sm" onclick="openStatusModal(@o.Id, '@o.Status')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <a href="/SellerOrder/PrintInvoice/@o.Id" target="_blank" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm">
            <form id="statusForm">
                <div class="modal-header bg-white border-bottom">
                    <h5 class="modal-title fw-bold">Edit Order Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-white">
                    <input type="hidden" id="orderId" name="orderId" />
                    <div class="mb-3">
                        <label class="form-label">Order Status</label>
                        <select class="form-select" id="orderStatus" name="status" required>
                            <option value="Pending">Pending</option>
                            <option value="Processing">Processing</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    let modal = new bootstrap.Modal(document.getElementById('statusModal'));

    function openStatusModal(id, currentStatus) {
        $("#orderId").val(id);
        $("#orderStatus").val(currentStatus);
        modal.show();
    }

    $("#statusForm").on("submit", function (e) {
        e.preventDefault();
        const id = $("#orderId").val();
        const status = $("#orderStatus").val();

        $.post('/SellerOrder/UpdateStatus', { id: id, status: status }, function (res) {
            if (res.success) {
                modal.hide();
                location.reload();
            } else {
                alert("Unable to update status!");
            }
        });
    });
</script>
}
