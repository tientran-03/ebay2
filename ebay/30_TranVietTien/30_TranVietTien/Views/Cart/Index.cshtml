@model IEnumerable<_30_TranVietTien.ViewModels.CartItemVM>

@{
    ViewData["Title"] = "My Cart";
    decimal subtotal = Model?.Sum(i => i.Price * i.Qty) ?? 0;
    decimal shipping = 5m;
    decimal total = subtotal + shipping;
}

<div class="container py-5">
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <i class="bi bi-bag-x fs-2 d-block mb-2"></i>
            Your cart is empty.
            <a asp-controller="Products" asp-action="Index" class="fw-semibold text-primary">Continue shopping</a>.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="table-responsive shadow-sm mb-4">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th width="80">Image</th>
                                <th>Product</th>
                                <th width="120">Price</th>
                                <th width="150">Quantity</th>
                                <th width="120">Subtotal</th>
                                <th width="50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@item.Image" class="img-fluid rounded border"
                                             style="width: 70px; height: 70px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        <strong>@item.Name</strong>
                                        <div class="text-muted small">ID: @item.ProductId</div>
                                    </td>
                                    <td>$@item.Price.ToString("0.00")</td>

                                    <td>
                                        <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex align-items-center">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="number" name="quantity" value="@item.Qty" min="1"
                                                   class="form-control form-control-sm text-center" style="width: 70px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary ms-2">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                    </td>

                                    <td class="fw-semibold">$@(item.Price * item.Qty)</td>

                                    <td>
                                        <form asp-controller="Cart" asp-action="Remove" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-link text-danger p-0">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Shipping Address</label>

                    @if (ViewBag.Addresses != null &&
                        ((List<_30_TranVietTien.Models.Address>)ViewBag.Addresses).Any())
                    {
                        <select class="form-select" name="addressId" form="checkoutForm" required>
                            @foreach (var a in (List<_30_TranVietTien.Models.Address>)ViewBag.Addresses)
                            {
                                <option value="@a.Id" selected="@(a.IsDefault == true)">
                                    @a.FullName - @a.Street (@a.City)
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="alert alert-warning p-2 mt-2">No address found.</div>
                    }

                    <a href="/Address/Index" class="small text-primary">Manage address</a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4">

                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>$<span id="subtotal">@subtotal</span></span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span>$<span id="shipping">@shipping</span></span>
                    </div>
                    <div class="mt-3 mb-3">
                        <label class="form-label fw-semibold">Coupon Code</label>
                        <div class="input-group">
                            <input type="text" id="couponCode" class="form-control" placeholder="Enter coupon code" />
                            <button id="applyCouponBtn" type="button" class="btn btn-dark">Apply</button>
                        </div>
                        <div id="couponMessage" class="small mt-1 text-danger"></div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3 fw-semibold">
                        <span>Total</span>
                        <span>$<span id="total">@total.ToString("0.00")</span></span>
                    </div>
                    <form asp-controller="Order" asp-action="Checkout" method="post" id="checkoutForm">

                        <!-- Hidden total after discount -->
                        <input type="hidden" id="finalTotal" name="finalTotal" value="@total" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Payment Method</label>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod"
                                       value="PayPal" checked />
                                <label class="form-check-label">PayPal</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod"
                                       value="COD" />
                                <label class="form-check-label">Cash on Delivery</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 mb-2">
                            Place Order
                        </button>
                    </form>

                    <a asp-controller="Products" asp-action="Index"
                       class="btn btn-outline-secondary w-100 rounded-pill mt-2">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
document.getElementById("applyCouponBtn").addEventListener("click", async () => {

    const code = document.getElementById("couponCode").value.trim();
    const subtotal = parseFloat(document.getElementById("subtotal").textContent);
    const shipping = parseFloat(document.getElementById("shipping").textContent);

    if (!code) {
        document.getElementById("couponMessage").textContent = "Please enter a coupon code.";
        return;
    }

    const response = await fetch("/Coupon/Apply", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `code=${code}&totalPrice=${subtotal}`
    });

    const result = await response.json();
    const msg = document.getElementById("couponMessage");

    if (result.success) {

        msg.textContent = "Coupon applied successfully!";
        msg.classList.remove("text-danger");
        msg.classList.add("text-success");

        const newTotal = parseFloat(result.newTotal) + shipping;

        document.getElementById("total").textContent = newTotal.toFixed(2);
        document.getElementById("finalTotal").value = newTotal.toFixed(2);

    } else {
        msg.textContent = result.message;
        msg.classList.remove("text-success");
        msg.classList.add("text-danger");
    }
});
</script>
}
