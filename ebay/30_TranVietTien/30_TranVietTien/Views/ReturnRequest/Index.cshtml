@model IEnumerable<_30_TranVietTien.Models.ReturnRequest>

<div class="container py-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <p>No return requests found.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">

                <table class="table table-striped table-borderless align-middle mb-0">
                    <thead class="border-bottom">
                        <tr>
                            <th class="text-center">Order</th>
                            <th style="width:250px;">Reason</th>
                            <th>Image</th>
                            <th>Status</th>
                            <th>Submitted</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-center">#@r.OrderId</td>

                                <td>@r.Reason</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(r.EvidenceImage))
                                    {
                                        <img src="@r.EvidenceImage"
                                             style="width:70px;height:70px;object-fit:cover;border-radius:4px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No image</span>
                                    }
                                </td>

                                <td>
                                    @if (r.Status == "Pending")
                                    {
                                        <span class="text-warning">Pending</span>
                                    }
                                    else if (r.Status == "Approved")
                                    {
                                        <span class="text-success">Approved</span>
                                    }
                                    else if (r.Status == "Rejected")
                                    {
                                        <span class="text-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@r.Status</span>
                                    }
                                </td>

                                <td class="text-muted small">@r.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }
</div>
