@model IEnumerable<_30_TranVietTien.Models.Coupon>
@{
    ViewData["Title"] = "Coupon Management";
    Layout = "_SellerLayout";
}

<style>
    .badge-active {
        background-color: #d1e7dd;
        color: #0f5132;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 13px;
    }

    .badge-expired {
        background-color: #f8d7da;
        color: #842029;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 13px;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1">Coupon Management</h4>
            <p class="text-muted mb-0">Create and manage discount coupons for your products</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#couponModal">
            <i class="bi bi-plus-circle me-1"></i>Add Coupon
        </button>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-tag fs-1 text-muted"></i>
        <h5 class="mt-3">No coupons found</h5>
        <p class="text-muted">Create discount coupons to attract more customers.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Discount (%)</th>
                            <th>Product</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Max Usage</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var isActive = c.EndDate >= DateTime.Now;
                            <tr>
                                <td class="fw-bold">@c.Code</td>
                                <td>
                                    <span class="badge bg-success">@c.DiscountPercent%</span>
                                </td>
                                <td class="text-start">
                                    @if (c.Product != null)
                                    {
                                        <div class="fw-semibold">@c.Product.Title</div>
                                        <small class="text-muted">@c.Product.Price?.ToString("N0") ₫</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No product</span>
                                    }
                                </td>
                                <td class="small">@c.StartDate?.ToString("dd/MM/yyyy")</td>
                                <td class="small">@c.EndDate?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary">@c.MaxUsage</span>
                                </td>
                                <td>
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Expired</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-outline-primary btn-sm" onclick="editCoupon(@c.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" onclick="deleteCoupon(@c.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Coupon Modal -->
<div class="modal fade" id="couponModal" tabindex="-1" aria-labelledby="couponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="couponForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="couponModalLabel">
                        <i class="bi bi-tag me-2"></i>Add / Edit Coupon
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="Id" id="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Coupon Code</label>
                            <input class="form-control" name="Code" id="Code" required placeholder="e.g., SAVE20" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Discount Percentage (%)</label>
                            <input type="number" class="form-control" name="DiscountPercent" id="DiscountPercent" 
                                   required min="1" max="100" placeholder="e.g., 20" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Product</label>
                            <select class="form-select" name="ProductId" id="ProductId" required>
                                <option value="">-- Select Product --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" name="StartDate" id="StartDate" required />
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" name="EndDate" id="EndDate" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Maximum Usage</label>
                            <input type="number" class="form-control" name="MaxUsage" id="MaxUsage" 
                                   required min="1" placeholder="e.g., 100" />
                            <div class="form-text">Number of times this coupon can be used</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $('#couponModal').on('show.bs.modal', function () {
        $.get('/SellerProduct/GetAll', function (res) {
            if (res && res.length > 0) {
                const select = $('#ProductId').empty().append('<option value="">-- Select Product --</option>');
                res.forEach(p => select.append(`<option value="${p.id}">${p.title}</option>`));
            }
        });
    });
    
    function editCoupon(id) {
        $.get(`/SellerCoupon/GetCoupon/${id}`, function (res) {
            if (!res.success) return alert("Coupon not found!");
            $("#Id").val(res.id);
            $("#Code").val(res.code);
            $("#DiscountPercent").val(res.discountPercent);
            $("#StartDate").val(res.startDate);
            $("#EndDate").val(res.endDate);
            $("#MaxUsage").val(res.maxUsage);
            $("#ProductId").val(res.productId);
            $("#couponModal").modal("show");
        });
    }
    
    $("#couponForm").on("submit", function (e) {
        e.preventDefault();
        $.ajax({
            url: "/SellerCoupon/Save",
            type: "POST",
            data: $(this).serialize(),
            success: function (res) {
                if (res.success) {
                    $("#couponModal").modal("hide");
                    location.reload();
                } else {
                    alert("Unable to save coupon!");
                }
            },
            error: () => alert("Server error!")
        });
    });
    
    function deleteCoupon(id) {
        if (!confirm("Are you sure you want to delete this coupon?")) return;
        $.post("/SellerCoupon/Delete", { id: id }, function (res) {
            if (res.success) location.reload();
            else alert("Unable to delete coupon!");
        });
    }
</script>
}
