{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft": "Warning"
    },
    "File": {
      "Path": "logs/app-.log",
      "RollingInterval": "Day",
      "FileSizeLimitBytes": 104857600,
      "RetainedFileCountLimit": 10
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=CloneEbayDB;User Id=ebay_app;Password=YourStrongPassword123!;TrustServerCertificate=true;Encrypt=false;"
  },

  "Session": {
    "IdleTimeout": "30", 
    "CookieName": ".eBayClone.Session",
    "CookieHttpOnly": true,
    "CookieIsEssential": true
  },
  "AppSettings": {
    "AppName": "eBay Clone",
    "Version": "1.0.0",
    "Author": "Your Name",
    "EnableEmailVerification": true
  }
}
